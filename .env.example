# Copy this file to .env and fill in your real values. Never commit .env to git.

# Port the server runs on
PORT=3000

# Public base URL of your site (used to build payment callback URLs).
# In local dev this can be http://localhost:3000
# In production this MUST be your real https domain, e.g. https://bdchildrenshaven.com
BASE_URL=http://localhost:3000

# Admin panel login (change this to something strong before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random long random string used to sign admin login sessions
SESSION_SECRET=replace-with-a-long-random-string

# SSLCommerz merchant credentials
# Get SANDBOX credentials free & instantly at https://developer.sslcommerz.com/registration/
# Get LIVE credentials after your business is verified with SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
# Set to "true" only once you switch to LIVE credentials
SSLCOMMERZ_IS_LIVE=false
